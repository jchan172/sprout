{
  // Cloudflare Worker config for Sprout.
  // "name" must exactly match the Worker name shown in the Cloudflare dashboard
  // (Workers & Pages → this project), or the build will fail.
  "name": "sprout",
  "main": "worker.js",
  "compatibility_date": "2026-10-09",
  "kv_namespaces": [
    {
      "binding": "SPROUT_KV",
      "id": "ca25bc1df45541ff966f8eaed4a46dc9"
    }
  ],
  "assets": {
    // The PWA lives at the repo root; see .assetsignore for what's excluded.
    "directory": "./",
    "binding": "ASSETS",
    // Make sure API requests always reach the Worker before asset matching.
    "run_worker_first": ["/api/*"]
  }
}
